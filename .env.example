# ==========================================
# SPRYGEN AI Assistant - Environment Config
# ==========================================

# AI & LLM Services (Optional / Hybrid Routing)
ANTHROPIC_API_KEY=""                # Anthropic Claude API Key (Cloud LLM routing)
GEMINI_API_KEY=""                   # Google Gemini API Key
SPRYGEN_OLLAMA_URL="http://127.0.0.1:11434" # Local Ollama LLM endpoint

# Biometrics & Voice Processing
PICOVOICE_ACCESS_KEY=""             # Picovoice Access Key for Porcupine wake word

# Ingest Adapters & OAuth2
GOOGLE_CLIENT_ID=""                 # Google Cloud OAuth 2.0 Client ID (Classroom sync)
GOOGLE_CLIENT_SECRET=""             # Google Cloud OAuth 2.0 Client Secret

# Device Sync Server
SPRYGEN_SYNC_PORT=8765              # WebSocket sync port for mobile companion app